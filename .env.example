# Copy to `.env` and fill in real values. Never commit `.env`.

# `mock` (default, no credentials needed) or `openai`
LLM_PROVIDER=mock

# Required when LLM_PROVIDER=openai
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=your-model-id-here
# Optional: OpenAI-compatible endpoint
# OPENAI_BASE_URL=https://api.example.com/v1

# Request behaviour
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Inference parameters (optional)
# LLM_SYSTEM_PROMPT="You are KnowledgePilot, a helpful assistant for company employees."
# LLM_TEMPERATURE=0.2
# LLM_MAX_OUTPUT_TOKENS=512

# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
